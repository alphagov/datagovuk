{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v2/tickets.json",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.ticket[?(@.comment.body contains 'Trigger Error')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "InternalServerError",
      "description": "An unexpected error occurred while processing the ticket."
    }
  }
}
