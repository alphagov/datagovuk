{
  "request": {
    "method": "POST",
    "urlPath": "/api/v2/tickets.json",
    "headers": {
      "Authorization": {
        "matches": "^(Basic|Bearer) .+$"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.ticket.subject"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "ticket": {
        "id": 101,
        "url": "https://yoursubdomain.zendesk.com/api/v2/tickets/101.json",
        "subject": "{{jsonPath request.body '$.ticket.subject'}}",
        "description": "{{jsonPath request.body '$.ticket.comment.subject'}}",
        "status": "new",
        "priority": "normal",
        "created_at": "2026-08-25T10:23:00Z"
      }
    }
  }
}
