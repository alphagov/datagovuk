<header role="banner" class="datagovuk-header">
  <div class="govuk-width-container datagovuk-width-container datagovuk-header__inner">
    <div class="datagovuk-header__logo">
      <a class="datagovuk-header__logo-link" href="/">

        <img src="{{ static('images/logo-ndl.svg') }}" width="200" height="61" class="datagovuk-header__logo-image" alt="Home" />
      </a>
    </div>
    <button type="button"
            class="datagovuk-header__button"
            id="datagovuk-header-button-all"
            aria-controls="datagovuk-menu-collections">Menu</button>

    {# Search is in the header on every page except the homepage, which has its own in the hero #}
    {% if not hide_header_search %}
      <form class="datagovuk-header__search"
            action="{{ url('directory:search') }}"
            method="get"
            role="search"
            id="header-search-form"
            data-clearable>
        <label class="govuk-visually-hidden" for="header-search-query">Search directory</label>
        <input class="datagovuk-header__search-input"
               type="search"
               id="header-search-query"
               name="query"
               placeholder="Search"
               maxlength="256"
               autocomplete="off"
               value="{{ header_search_query|default('') }}" />
        <button class="datagovuk-header__search-button" type="submit">
          <img src="{{ static('images/icons/search.svg') }}" width="24" height="24" alt="" />
          <span class="govuk-visually-hidden">Search</span>
        </button>
        <button class="datagovuk-header__search-button datagovuk-search-clear" type="button" data-clear>
          <img src="{{ static('images/icons/cancel.svg') }}" width="20" height="20" alt="" />
          <span class="govuk-visually-hidden">Clear search</span>
        </button>
      </form>
    {% endif %}

    <div class="datagovuk-header__nav">
      <button type="button"
              class="datagovuk-header__button"
              id="datagovuk-header-button-collections"
              aria-controls="datagovuk-menu-collections">Collections</button>
      <a class="datagovuk-header__link" href="{{ url('pages:help') }}">Help</a>
    </div>

    <div class="datagovuk-menu" id="datagovuk-menu-collections">
      <h2 class="datagovuk-menu__heading">Collections</h2>
      <div class="datagovuk-menu__items">
        {% for collection in collections %}
          <a href="{{ url('collections:collection', kwargs={'collection_name': collection['slug']}) }}"
             class="govuk-link datagovuk-link datagovuk-menu__item-link{% if collection.is_spotlight %} datagovuk-menu__item-spotlight-link{% endif %}">
            {{ collection["title"] }}
            {% if collection.is_spotlight %}<span class="datagovuk-menu__spotlight-tag">Spotlight</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
  {{ header_end or "" }}
</header>
