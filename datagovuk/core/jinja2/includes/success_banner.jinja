<div class="datagovuk-notification-banner datagovuk-notification-banner--success"
     role="region"
     aria-label="success notification banner"
     data-module="notification-banner-close"
     tabindex="-1">
  <div class="datagovuk-notification-banner__content">
    <img class="datagovuk-notification-banner__icon" src="{{ static('images/success.svg') }}" alt="" />
    <div class="datagovuk-notification-banner__text">
      <p class="govuk-body datagovuk-body">{{ message.message }}</p>
    </div>
    <a class="datagovuk-close govuk-link datagovuk-link" href="#" aria-label="Close success banner">
      <img class="datagovuk-close__image" src="{{ static('images/close_success.svg') }}" alt="" />
    </a>
  </div>
</div>
