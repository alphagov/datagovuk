<header role="banner" class="datagovuk-header">
  <div class="govuk-width-container datagovuk-width-container datagovuk-header__inner">
    <div class="datagovuk-header__logo">
      <a class="datagovuk-header__logo-link" href="/">
        <img src="{{ static('images/logo-ndl.svg') }}" width="200" height="61" class="datagovuk-header__logo-image"
          alt="Home" />
      </a>
    </div>
    <button type="button" class="datagovuk-header__button" id="datagovuk-header-button-all"
      aria-controls="datagovuk-menu-collections">Menu</button>
    <form method="get" action="{{ url('search:search') }}" role="search" class="datagovuk-header__search">
      <div class="datagovuk-header__search-field datagovuk-form-group">
        <label class="govuk-label govuk-visually-hidden" for="datagovuk-header-search">Search</label>
        <input class="govuk-input datagovuk-header__search-input" id="datagovuk-header-search" name="query"
          type="search" value="{{ search_query or '' }}" placeholder="Search" />
        <button type="submit"
          class="govuk-button datagovuk-button datagovuk-button--secondary datagovuk-header__search-button">
          <span class="govuk-visually-hidden">Search</span>
        </button>
      </div>
    </form>
    <button type="button" class="datagovuk-header__button" id="datagovuk-header-button-collections"
      aria-controls="datagovuk-menu-collections">Collections</button>
    <div class="datagovuk-menu" id="datagovuk-menu-collections">
      <h2 class="datagovuk-menu__heading">Collections</h2>
      <div class="datagovuk-menu__items">
        {% for collection in collections %}
          <a href="{{ url('collections:collection', kwargs={'collection_name': collection['slug']}) }}"
            class="govuk-link datagovuk-link datagovuk-menu__item-link{% if collection.is_spotlight %} datagovuk-menu__item-spotlight-link{% endif %}">
            {{ collection["title"] }}
            {% if collection.is_spotlight %}<span class="datagovuk-menu__spotlight-tag">Spotlight</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="datagovuk-menu">
      <div class="datagovuk-menu__items">
        <a href="{{ url('pages:help') }}" class="govuk-link datagovuk-link datagovuk-menu__item-link">Help</a>
      </div>
    </div>
    <a class="datagovuk-header__link" href="{{ url('pages:help') }}">Help</a>
  </div>
  {{ header_end or "" }}
</header>