{% extends "base.jinja" %}

{% if image %}
  {% set og_image = request.build_absolute_uri(static(image.src)) %}
{% endif %}

{% block page_title %}
  {{ title }} - Updates - National Data Library
{% endblock page_title %}

{% block main %}
  <div class="govuk-width-container datagovuk-width-container govuk-!-margin-top-9">
    <div class="govuk-grid-row govuk-!-margin-bottom-9">
      <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl datagovuk-heading-xl">{{ title }}</h1>
        <p class="govuk-body datagovuk-body datagovuk-!-colour-grey">
          {% if authors %}
            By
            {% for author in authors -%}
              <a href="{{ url('pages:team') }}" class="govuk-link datagovuk-link">{{ author }}</a>
              {%- if not loop.last %},
              {% endif -%}
            {%- endfor %} ·
          {% endif %}
          <time datetime="{{ date.isoformat() }}">{{ date.strftime("%-d %B %Y") }}</time>
        </p>
      </div>
    </div>
  </div>
  {% if image %}
    <img src="{{ static(image.src) }}"
         {% if image.width %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
         alt="{{ image.alt }}"
         class="datagovuk-image datagovuk-image--full-width govuk-!-margin-bottom-6" />
  {% endif %}
  <div class="govuk-width-container datagovuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds-from-desktop">
        <div class="datagovuk-content">{{ content|safe }}</div>
      </div>
    </div>
  </div>
{% endblock main %}
