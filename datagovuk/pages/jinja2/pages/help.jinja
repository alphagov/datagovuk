{% extends "base.jinja" %}

{% block main %}
  <div class="govuk-width-container datagovuk-width-container govuk-!-margin-top-9">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-thirds datagovuk-help-heading">
        <h1 class="govuk-heading-l datagovuk-heading-l">Help</h1>
      </div>
    </div>
  </div>

  <div class="govuk-width-container datagovuk-width-container">
    <section class="govuk-!-margin-bottom-6">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
          <ul class="datagovuk-gridlist">
            {% for item in help_items %}
              <li class="datagovuk-gridlist__item">
                <h2 class="govuk-body datagovuk-body">
                  <a class="govuk-link datagovuk-link datagovuk-link--secondary" href="{{ item.url }}">{{ item.title }}</a>
                </h2>
                <p class="govuk-body datagovuk-body">{{ item.description }}</p>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <section class="govuk-!-margin-bottom-9">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-thirds">{% include "includes/feedback.jinja" %}</div>
      </div>
    </section>
  </div>

{% endblock main %}
