{% extends "base.jinja" %}

{% set directory_heading_level = directory_heading_level|default("h1") %}
{% from "govuk_frontend_jinja/components/button/macro.html" import govukButton -%}
{% from "govuk_frontend_jinja/components/input/macro.html" import govukInput -%}

{% block main %}
  <div class="govuk-width-container datagovuk-width-container">
    <form method="get" action="{{ url('search:search') }}">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
          <div class="datagovuk-search-bar">
            {# djlint:off #}
            <div class="datagovuk-search-input-wrapper">
            {{ govukInput({
                "label": {
                "text": "Search directory",
                "classes":"govuk-visually-hidden"
                },
                "attributes":{
                    "placeholder":"Search directory",
                    "autocomplete":"off"
                },
                "name": "query",
                "value": form.query.value() if form else "",
                "errorMessage": {"html": form.query.errors} if form and form.query.errors else None,
                "formGroup": {"classes": "datagovuk-form-group"},
            }) }}
            </div>
            {{ govukButton({
                "html": "<span class=\"govuk-visually-hidden\">Search</span>",
                "classes": "datagovuk-button datagovuk-button--secondary"
            })}}
            </div>
        </div>
      </div>
      {% block search_main %}
      {% endblock %}
    </form>
  </div>
{% endblock main %}
