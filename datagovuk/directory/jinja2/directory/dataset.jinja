{% extends "directory/base.jinja" %}

{% set page_title = "Dataset" %}
{% set directory_heading_level = "h2" %}
{% from "govuk_frontend_jinja/components/summary-list/macro.html" import govukSummaryList -%}
{% from "govuk_frontend_jinja/components/button/macro.html" import govukButton -%}

{% block search_main %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl datagovuk-heading-xl govuk-!-margin-bottom-4">{{ doc.title }}</h1>
      {% set licence_html %}
        {% if doc.licence_title and doc.licence_url %}
          <a href="{{ doc.licence_url }}" class="govuk-link datagovuk-link">{{ doc.licence_title }}</a>
        {% elif doc.licence_title %}
          {{ doc.licence_title }}
        {% else %}
          Not set
        {% endif %}
      {% endset %}
      {# djlint:off #}
      {{ govukSummaryList({
        "rows": [
          {
            "key": {"text": "Published By:"},
            "value": {"text": doc.organisation.title},
          },
          {
            "key": {"text": "Last updated:"},
            "value": {"text": doc.public_updated_at|date("d F Y")},
          },
          {
            "key": {"text": "Topic:"},
            "value": {"text": doc.topic or "Not set"},
          },
          {
            "key": {"text": "Licence:"},
            "value": {"html": licence_html},
          },
        ],
        "classes": "datagovuk-summary-list govuk-summary-list--no-border",
      }) }}
      {# djlint:on #}
      <h2 class="govuk-heading-l datagovuk-heading-l">Summary</h2>
      <div class="govuk-!-margin-bottom-2 govuk-body datagovuk-body">{{ doc.summary }}</div>
      <h2 class="govuk-heading-l datagovuk-heading-l">Data links</h2>
      {% if doc.datafiles %}
        <div class="govuk-!-margin-bottom-8">
          <div class="datagovuk-table-container" tabindex="0" role="region">
            <table class="govuk-table datagovuk-table">
              <thead class="govuk-table__head datagovuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header datagovuk-table__header datagovuk-table__header--wrap govuk-body datagovuk-body">
                    Link
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Format
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Preview
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Last updated
                  </th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                {% for resource in doc.datafiles %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--wrap govuk-body datagovuk-body">
                      <a href="{{ resource.url }}" class="govuk-link datagovuk-link">{{ resource.name }}</a>
                      {% if resource.size %}({{ resource.size|format_file_size }}){% endif %}
                    </td>
                    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
                      {{ resource.format }}
                    </td>
                    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
                      {% if resource.is_csv %}
                        <a href="{{ url('directory:preview', kwargs={'dataset_uuid': doc.uuid, 'name': doc.name, 'datafile_uuid': resource.uuid}) }}"
                           class="govuk-link datagovuk-link">Preview</a>
                      {% else %}
                        Not available
                      {% endif %}
                    </td>
                    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
                      {{ resource.last_modified|date("d/m/Y") }}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% else %}
        <div class="govuk-!-margin-bottom-8">
          <p class="govuk-body datagovuk-body">This data hasn’t been released by the publisher.</p>
        </div>
      {% endif %}

      {% if doc.docs %}
        {% with supporting_documents=doc.docs %}
          {% include "directory/includes/supporting_documents.jinja" %}
        {% endwith %}
      {% endif %}

      {% if doc.contact_email or doc.foi_email or doc.foi_web %}
        {% set pub = doc.organisation.name %}
        <section class="contact">
          <h2 class="govuk-heading-l datagovuk-heading-l">Contact</h2>

          {% if doc.contact_email %}
            <h3 class="govuk-heading-m datagovuk-heading-m">Enquiries</h3>
            <p class="govuk-body datagovuk-body">
              <a href="{{ 'mailto:' ~ doc.contact_email }}"
                 class="govuk-link datagovuk-link datagovuk-link--secondary"
                 data-ga-event="contact"
                 data-ga-publisher="{{ pub }}">{{ doc.contact_email }}</a>
            </p>
          {% endif %}

          {% if doc.foi_email or doc.foi_web %}
            <h3 class="govuk-heading-m datagovuk-heading-m">FOI requests</h3>
            {% if doc.foi_email %}
              <p class="govuk-body datagovuk-body govuk-!-margin-bottom-1">
                <a href="{{ 'mailto:' ~ doc.foi_email }}"
                   class="govuk-link datagovuk-link datagovuk-link--secondary"
                   data-ga-event="contact"
                   data-ga-publisher="{{ pub }}">{{ doc.foi_email }}</a>
              </p>
            {% endif %}
            {% if doc.foi_web %}
              <p class="govuk-body datagovuk-body">
                <a href="{{ doc.foi_web }}"
                   class="govuk-link datagovuk-link datagovuk-link--secondary"
                   data-ga-event="contact"
                   data-ga-publisher="{{ pub }}">Make a Freedom of Information request online</a>
              </p>
            {% endif %}
          {% endif %}
        </section>
      {% endif %}
      <section class="edit">
        <h2 class="govuk-heading-l datagovuk-heading-l">Edit this dataset</h2>
        <p class="govuk-body datagovuk-body">
          You must have an account for this publisher on data.gov.uk to make any changes to a dataset.
        </p>
        {% set ckan_base_url = "https://ckan.publishing.service.gov.uk/dataset/edit/" %}
        {# djlint:off #}
        {{govukButton({
          "html": '''
            Sign in <span class="datagovuk-right-arrow">
            <img class="datagovuk-button__arrow" src="/assets/images/icons/arrow-white-right.svg" width="20" height="20" alt="">
            <img class="datagovuk-button__arrow--focus" src="/assets/images/icons/arrow-black-right.svg" width="20" height="20" alt="">
            </span>
          ''',
          "href": ckan_base_url ~ doc.name,
          "classes": "datagovuk-button",
        })}}
        {# djlint:on #}
      </section>
    </div>
    <div class="govuk-grid-column-one-third">
      <section class="more-from-publisher">
        <div class="datagovuk-card">
          <h2 class="govuk-heading-m datagovuk-heading-m">More from this publisher</h2>
          <p class="govuk-body datagovuk-body">
            {# djlint:off #}
            <a href="{{ url("directory:search") ~ "?publisher=" ~ doc.organisation.title }}"
               class="govuk-link datagovuk-link datagovuk-link--secondary">
              All datasets from {{ doc.organisation.title }}
            </a>
            {# djlint:on #}
          </p>
        </div>
      </section>
    </div>
  </div>
{% endblock search_main %}
