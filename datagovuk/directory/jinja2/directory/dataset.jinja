{% extends "directory/base.jinja" %}

{% set page_title = doc.title %}
{% set hide_directory_header = true %}
{% from "govuk_frontend_jinja/components/button/macro.html" import govukButton -%}
{% from "macros/common.jinja" import cta_button %}

{% macro resource_row(resource, doc) %}
  <tr class="govuk-table__row">
    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--wrap govuk-body datagovuk-body">
      <a href="{{ resource.url }}" class="govuk-link datagovuk-link">{{ resource.name or "Data" }}</a>
      {% if resource.size %}({{ resource.size|format_file_size }}){% endif %}
    </td>
    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
      {{ resource.format }}
    </td>
    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
      {% if resource.is_csv %}
        <a href="{{ url('directory:preview', kwargs={'dataset_uuid': doc.uuid, 'name': doc.name, 'datafile_uuid': resource.uuid}) }}"
           class="govuk-link datagovuk-link">Preview</a>
      {% else %}
        N/A
      {% endif %}
    </td>
    <td class="govuk-table__cell datagovuk-table__cell datagovuk-table__cell--compact govuk-body datagovuk-body">
      {{ resource.last_modified|date("d/m/Y") }}
    </td>
  </tr>
{% endmacro %}

{% macro render_publisher_string(value) %}
  {#
    String is supplied by publishers and can contain a mixture of markdown
    and HTML.
    Firstly sanitize the string according to our list of allowed HTML tags/attributes.
    Next, if the string is html convert the html to markdown and use datagovuk's markdown renderer to get the right styles.
    Otherwise, if the string is not html just use datagovuk's markdown renderer to get the right styles.
  #}
  {% set sanitized = value|sanitize_html %}
  {% if sanitized|is_html %}
    {{ sanitized|html_to_markdown|markdown_to_html }}
  {% else %}
    {{ sanitized|markdown_to_html }}
  {% endif %}
{% endmacro %}

{% block extra_head %}
  <meta name="dc:title" content="{{ doc.title }}" />
  <meta name="dc:publisher" content="{{ doc.organisation.title }}" />
  <meta name="dc:date" content="{{ doc.public_updated_at|date('Y-m-d') }}" />

  {% if doc.licence_title %}<meta name="dc:rights" content="{{ doc.licence_title }}" />{% endif %}
{% endblock extra_head %}

{% block search_main %}
  <div class="datagovuk-dataset">
    <h1 class="datagovuk-dataset__title{% if doc.title|length > 100 %} datagovuk-dataset__title--long{% endif %}"
        property="dc:title">{{ doc.title }}</h1>

    <div class="datagovuk-dataset__content">
      {% set licence_html %}
        <span property="dc:rights">
          {% if doc.licence_title and doc.licence_url %}
            <a href="{{ doc.licence_url }}" class="datagovuk-dataset__link datagovuk-dataset__link--plain" rel="dc:rights">{{ doc.licence_title }}</a>
          {% elif doc.licence_title %}
            {{ doc.licence_title }}
          {% elif doc.licence_custom %}
            <a href="#licence-information" class="datagovuk-dataset__link datagovuk-dataset__link--plain">View licence information</a>
          {% else %}
            Not set
          {% endif %}
        </span>
      {% endset %}

      <dl class="datagovuk-metadata">
        <div class="datagovuk-metadata__row">
          <dt class="datagovuk-metadata__label">Published by:</dt>
          <dd class="datagovuk-metadata__value">
            <span property="dc:publisher">{{ doc.organisation.title }}</span>
          </dd>
        </div>
        <div class="datagovuk-metadata__row">
          <dt class="datagovuk-metadata__label">Last updated:</dt>
          <dd class="datagovuk-metadata__value">
            <span property="dc:date">{{ doc.public_updated_at|date("j F Y") }}</span>
          </dd>
        </div>
        <div class="datagovuk-metadata__row">
          <dt class="datagovuk-metadata__label">Topic:</dt>
          <dd class="datagovuk-metadata__value">
            {{ doc.topic or "Not set" }}
          </dd>
        </div>
        <div class="datagovuk-metadata__row">
          <dt class="datagovuk-metadata__label">Licence:</dt>
          <dd class="datagovuk-metadata__value">
            {{ licence_html }}
          </dd>
        </div>
      </dl>

      <section class="datagovuk-dataset__section">
        <h2 class="datagovuk-dataset__heading">Summary</h2>
        <div class="datagovuk-dataset__summary">
          <div id="summary" class="datagovuk-dataset__text datagovuk-dataset-summary datagovuk-line-clamp" property="dc:description">
            {{ render_publisher_string(doc.summary) }}
          </div>
          {{ govukButton({
            "text": "View full summary",
            "type": "button",
            "classes": "datagovuk-button datagovuk-button--secondary datagovuk-line-clamp-toggle",
            "attributes": {
              "aria-controls": "summary",
              "data-hide-text": "Hide full summary"
            }
          }) }}
        </div>
      </section>

      <section class="datagovuk-dataset__section">
        <h2 class="datagovuk-dataset__heading">Data links</h2>
        {% if doc.datafiles %}
          <div id="datagovuk-resources-table" class="datagovuk-table-container" tabindex="0" role="region">
            <table class="govuk-table datagovuk-table">
              <thead class="govuk-table__head datagovuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header datagovuk-table__header datagovuk-table__header--wrap govuk-body datagovuk-body">
                    Link
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Format
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Preview
                  </th>
                  <th scope="col"
                      class="govuk-table__header datagovuk-table__header datagovuk-table__header--compact govuk-body datagovuk-body">
                    Last update
                  </th>
                </tr>
              </thead>
              {% set datafiles_start, datafiles_rest = doc.datafiles[:4], doc.datafiles[4:] %}
              <tbody class="govuk-table__body">
                {% for resource in datafiles_start %}{{ resource_row(resource, doc) }}{% endfor %}
              </tbody>
              {% if datafiles_rest %}
                <tbody id="truncated-resources-rest" class="govuk-table__body">
                  {% for resource in datafiles_rest %}{{ resource_row(resource, doc) }}{% endfor %}
                </tbody>
              {% endif %}
            </table>
          </div>
          {% if datafiles_rest %}
            {{ govukButton({
              "text": "Show more",
              "type": "button",
              "classes": "datagovuk-button datagovuk-button--secondary datagovuk-visibility-toggle",
              "attributes": {
                "aria-controls": "truncated-resources-rest",
                "data-hide-text": "Show less"
              }
            }) }}
          {% endif %}
        {% else %}
          <p class="datagovuk-dataset__text">There are no links to this data.</p>
        {% endif %}
      </section>

      {% with dataset=true %}
        {% include "includes/feedback.jinja" %}
      {% endwith %}

      {% if doc.additional_information %}
        {% with additional_information=doc.additional_information %}
          {% include "directory/includes/additional_information.jinja" %}
        {% endwith %}
      {% endif %}

      {% if doc.docs %}
        {% with supporting_documents=doc.docs %}
          {% include "directory/includes/supporting_documents.jinja" %}
        {% endwith %}
      {% endif %}

      {% if doc.contact_email or doc.foi_email or doc.foi_web %}
        <section class="datagovuk-dataset__section contact">
          <h2 class="datagovuk-dataset__heading">Contact</h2>
          <div class="datagovuk-dataset__contacts">
            {% set contact_email_is_email = "@" in doc.contact_email %}
            {% if doc.contact_email %}
              <div class="datagovuk-dataset__contact">
                <h3 class="datagovuk-dataset__text">Enquiries</h3>
                <a href="{{ 'mailto:' ~ doc.contact_email if contact_email_is_email else doc.contact_email }}"
                   class="datagovuk-dataset__link">{{ doc.contact_email if contact_email_is_email else "Enquiries" }}</a>
              </div>
            {% endif %}

            {% set foi_email_is_email = "@" in doc.foi_email %}
            {% if doc.foi_email or doc.foi_web %}
              <div class="datagovuk-dataset__contact">
                <h3 class="datagovuk-dataset__text">Freedom of Information (FOI) requests</h3>
                {% if doc.foi_email %}
                  <a href="{{ 'mailto:' ~ doc.foi_email if foi_email_is_email else doc.foi_email }}" class="datagovuk-dataset__link">{{ doc.foi_email if foi_email_is_email else "Freedom of Information (FOI) requests" }}</a>
                {% endif %}
                {% if doc.foi_web %}
                  <a href="{{ doc.foi_web }}" class="datagovuk-dataset__link">Freedom of information requests for this dataset</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}

      {% if doc.licence_custom %}
        <section class="datagovuk-dataset__section licence-information">
          <h2 id="licence-information" class="datagovuk-dataset__heading">Licence information</h2>
          <div class="datagovuk-dataset__text">{{ render_publisher_string(doc.licence_custom) }}</div>
        </section>
      {% endif %}

      {% if not doc.harvested %}
        <section class="datagovuk-dataset__section edit">
          <h2 class="datagovuk-dataset__heading">Edit this dataset</h2>
          <p class="datagovuk-dataset__text">
            You must have an account for this publisher on data.gov.uk to make any changes to a dataset.
          </p>
          {{ cta_button(url('data_manual:home') , 'Data manual', 'link') }}
        </section>
      {% endif %}
    </div>

    <aside class="datagovuk-dataset__secondary" aria-label="More from this publisher">
      <section class="datagovuk-publisher-card">
        <h2 class="datagovuk-publisher-card__heading">More from this publisher</h2>
        <p class="datagovuk-publisher-card__name">
          {# djlint:off #}
          <a href="{{ url("directory:search") ~ "?publisher=" ~ (doc.organisation.title|urlencode) }}"
             class="datagovuk-publisher-card__link">{{ doc.organisation.title }}</a>
          {# djlint:on #}
        </p>
      </section>
    </aside>
  </div>
{% endblock search_main %}
