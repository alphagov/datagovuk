{% extends "base.jinja" %}

{% set directory_heading_level = directory_heading_level|default("h1") %}

{# Pages can set `hide_directory_header = true` to drop the Directory band (set before this template renders) #}
{% set header_end %}
  {% if not hide_directory_header %}
    <div class="datagovuk-directory-header">
      <div class="govuk-width-container datagovuk-width-container datagovuk-directory-header__inner">
        <div class="datagovuk-directory-header__logo">
          {# djlint:off #}
      <{{ directory_heading_level }} class="govuk-!-margin-bottom-0 govuk-heading-m datagovuk-heading-m">
        <a class="datagovuk-directory-header__logo-link" href="{{ url('directory:search') }}">Directory</a>
      </{{ directory_heading_level }}>
          {# djlint:on #}
        </div>
        <a class="datagovuk-directory-header__link" href="{{ url('pages:publishers') }}">Publish your data</a>
        <a class="datagovuk-directory-header__link" href="https://guidance.data.gov.uk/publish_and_manage_data/">Documentation</a>
        <a class="datagovuk-directory-header__link" href="{{ url('support:support-form') }}">Support</a>

        <button type="button"
                class="datagovuk-directory-header__button"
                id="datagovuk-directory-header-button-all"
                aria-controls="datagovuk-directory-menu">Menu</button>

        <div class="datagovuk-directory-menu">
          <div class="datagovuk-directory-menu__items">
            <a href="{{ url('pages:publishers') }}" class="govuk-link datagovuk-link datagovuk-menu__item-link">Publish your data</a>
            <a href="#" class="govuk-link datagovuk-link datagovuk-menu__item-link">Documentation</a>
            <a href="{{ url('support:support-form') }}" class="govuk-link datagovuk-link datagovuk-menu__item-link">Support</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{% endset %}

{% block main %}
  <div class="govuk-width-container datagovuk-width-container">
    <form method="get" action="{{ url('directory:search') }}">
      {# The search box is in the site header; filters on this page submit the current search along with them #}
      <input type="hidden" name="query" value="{{ form.query.value() or '' if form else '' }}" />
      {% if form and form.query.errors %}
        <p class="govuk-error-message datagovuk-error-message" role="alert">
          <span class="govuk-visually-hidden">Error:</span>
          {{ form.query.errors|join(" ") }}
        </p>
      {% endif %}
      {% block search_main %}
      {% endblock search_main %}
    </form>
  </div>
{% endblock main %}
